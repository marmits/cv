{
  "private": true,
  "type": "module",
  "scripts": {
    "init": "resumed init",
    "start": "node index.js",
    "build": "resumed render resume.json --theme jsonresume-theme-stackoverflowmar && mv resume.html index.html && npm start",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "dependencies": {
    "jsonresume-theme-stackoverflowmar": "file:../jsonresume-theme-stackoverflowmar",
    "puppeteer": "^25.16.0",
    "resumed": "^7.1.0"
  },
  "allowScripts": {
    "puppeteer@25.16.0": true
  },
  "name": "jsonresumemarmits",
  "version": "2.0.0",
  "main": "index.js",
  "author": "",
  "license": "ISC",
  "description": "Build JSON Resume HTML/PDF with StackOverflowMar theme"
}
